{
    "name": "takuma/laravel-reporter",
    "description": "Meldet Laravel-, PHP-Version und installierte Pakete an den takuma manager.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Takuma\\LaravelReporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Takuma\\LaravelReporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Takuma\\LaravelReporter\\ReporterServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test",
        "test:types": "phpstan analyse",
        "test:unit": "phpunit",
        "test": ["@test:lint", "@test:types", "@test:unit"]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
